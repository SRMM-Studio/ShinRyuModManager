<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ShinRyuModManager.UserInterface.ViewModels"
    x:Class="ShinRyuModManager.UserInterface.Views.LogWindow"
    x:DataType="vm:LogWindowViewModel"
    Title="Console Output" Width="900" Height="500"
    Background="#0C0C0C">
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="6">
            <CheckBox Name="AutoScroll" IsChecked="True" Content="Auto-scroll" Foreground="White" Margin="6, 0, 0, 0" />
            <Button Content="Copy all" Click="CopyAll_OnClick" />
            <Button Content="Open logs folder" Click="OpenLogs_OnClick" />
        </StackPanel>
        
        <ListBox Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent"
                 FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="13">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6, 0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
            
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LogLineItem">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" TextWrapping="NoWrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    
</Window>
